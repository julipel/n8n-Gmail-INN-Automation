      "parameters": {
        "jsCode": "// n8n Code node (Run Once for All Items)\n// Input: like your example (id/threadId/headers object/text/html/from/to/subject/date)\n// Output: array of items [{ json: {...} }]\n\nfunction stripPrefix(s = '', prefix = '') {\n  s = String(s || '').trim();\n  if (!prefix) return s;\n  const re = new RegExp(`^${prefix}\\\\s*:\\\\s*`, 'i');\n  return s.replace(re, '').trim();\n}\n\nfunction cleanHtml(s = '') {\n  return String(s || '')\n    .replace(/<br\\s*\\/?>/gi, '\\n')\n    .replace(/<\\/p>|<\\/div>/gi, '\\n')\n    .replace(/<[^>]+>/g, '')\n    .replace(/&nbsp;/g, ' ')\n    .replace(/\\r/g, '')\n    .trim();\n}\n\nfunction extractEmail(s = '') {\n  s = String(s || '');\n  const m = s.match(/<([^>]+)>/);\n  if (m) return m[1].trim();\n  const m2 = s.match(/[A-Z0-9._%+-]+@[A-Z0-9.-]+\\.[A-Z]{2,}/i);\n  return m2 ? m2[0].trim() : s.trim();\n}\n\nfunction pickField(text, labels) {\n  // supports both \"ИНН: 123\" and \"ИНН 123\"\n  for (const label of labels) {\n    let re = new RegExp(`(?:^|\\\\n)\\\\s*${label}\\\\s*:\\\\s*(.+)`, 'i');\n    let m = text.match(re);\n    if (m?.[1]) return m[1].trim();\n\n    re = new RegExp(`(?:^|\\\\n)\\\\s*${label}\\\\s+(.+)`, 'i');\n    m = text.match(re);\n    if (m?.[1]) return m[1].trim();\n  }\n  return '';\n}\n\nconst items = $input.all();\n\nreturn items.map((item) => {\n  const msg = item.json || {};\n  const headers = msg.headers || {};\n\n  // 1) sender email\n  const sender_email =\n    msg.from?.value?.[0]?.address\n      ? String(msg.from.value[0].address).trim()\n      : extractEmail(stripPrefix(headers.from || msg.from?.text || '', 'From'));\n\n  // 2) subject/date\n  const subject =\n    (msg.subject && String(msg.subject).trim()) ||\n    stripPrefix(headers.subject || '', 'Subject') ||\n    '';\n\n const messageDateRaw =\n  (msg.date && String(msg.date).trim()) ||\n  stripPrefix(headers.date || '', 'Date') ||\n  '';\n\nlet message_date = '';\nif (messageDateRaw) {\n  const dt = DateTime.fromJSDate(new Date(messageDateRaw), { zone: 'utc' });\n  message_date = dt.setZone('Europe/Moscow').toFormat('yyyy-LL-dd HH:mm:ss');\n}\n\n  // 3) ids\n  const message_id = msg.id || msg.messageId || stripPrefix(headers['message-id'] || '', 'Message-Id') || '';\n  const thread_id = msg.threadId || '';\n\n  // 4) body: prefer msg.text\n  const bodyText =\n    (msg.text && String(msg.text).trim()) ||\n    cleanHtml(msg.html || msg.textAsHtml || '');\n\n  // 5) extract fields\n  let inn = pickField(bodyText, ['ИНН', 'INN', 'Tax ID']);\n  if (!inn) {\n    const m = bodyText.match(/\\b(\\d{10}|\\d{12})\\b/);\n    inn = m ? m[1] : '';\n  }\n  inn = String(inn).replace(/\\D/g, '');\n\n  const org_name = pickField(bodyText, [\n    'Название организации',\n    'Наименование организации',\n    'Наименование',\n    'Организация',\n    'Компания',\n    'Название',\n  ]);\n\n  const org_address = pickField(bodyText, [\n    'Адрес',\n    'Юридический адрес',\n    'Фактический адрес',\n  ]);\n\n  return {\n    json: {\n      sender_email,\n      inn,\n      org_name,\n      org_address,\n      message_date,\n      subject,\n      message_id,\n      thread_id,\n      body_short: bodyText.slice(0, 500),\n      body_full: bodyText,\n    }\n  };\n});"
      },
