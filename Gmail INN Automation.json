    {
      "parameters": {
        "jsCode": "function normalizeInn(value = '') {\n  return String(value).replace(/\\D+/g, '').trim();\n}\n\nconst parsedItems = $items(\"Code - Parse Email\");\nconst incoming = (parsedItems[0] && parsedItems[0].json) ? parsedItems[0].json : {};\nconst rows = $input.all().map(i => i.json || {});\n\nconst inn = normalizeInn(incoming.inn || '');\nconst innKeys = ['inn', 'ИНН', 'Inn', 'INN'];\n\nfunction getRowInn(row) {\n  for (const k of innKeys) {\n    if (row[k] !== undefined && row[k] !== null) return normalizeInn(row[k]);\n  }\n  return '';\n}\n\nconst exists = !!inn && rows.some(r => getRowInn(r) === inn);\n\nreturn [{\n  json: {\n    ...incoming,\n    inn,\n    inn_exists: exists,\n    rows_count: rows.length\n  }\n}];"
      },
